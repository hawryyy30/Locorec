{
  "manifest_version": 3,
  "name": "Locorec",
  "version": "1.1",
  "description": "Records a smooth, native-feeling scroll of the current tab.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "downloads", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}